# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Environment & Local Config
# ==========================================
.env
.env.local
.env.*.local
*.local

